DB_HOST=localhost
DB_PORT=5432
DB_NAME=OMEXP
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# --- Lapisan serving (opsional, semua ada nilai bawaannya) -------------------
BATCH_CACHE_TTL_SECONDS=3600
WARMUP_BATCH_ON_STARTUP=false
DEFAULT_RECOMMENDATION_LIMIT=50
MAX_RECOMMENDATION_LIMIT=500
DATA_FRESHNESS_TTL_SECONDS=60
CORS_ALLOW_ORIGINS=
API_KEY=
# Level log terendah yang dicetak (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO

# Dashboard hanya bicara ke API, tidak pernah ke database.
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_PASSWORD=  
