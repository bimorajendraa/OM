# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.

# --- Database (READ-ONLY) ----------------------------------------------------
# Aplikasi hanya melakukan SELECT; sesinya dipaksa read-only di level database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=OMEXP
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# --- Lapisan serving (opsional, semua ada nilai bawaannya) -------------------
# Berapa lama hasil batch scoring dipakai ulang sebelum dihitung ulang (detik).
BATCH_CACHE_TTL_SECONDS=3600
# Hitung batch saat aplikasi start, bukan saat request pertama datang.
# Start jadi lebih lama, tetapi pengguna pertama tidak menunggu.
WARMUP_BATCH_ON_STARTUP=false
# Batas jumlah baris yang boleh diminta sekali panggil.
DEFAULT_RECOMMENDATION_LIMIT=50
MAX_RECOMMENDATION_LIMIT=500
# Seberapa sering batas waktu data diperiksa ulang (detik). Ini juga yang
# menentukan seberapa cepat data baru terlihat oleh aplikasi.
DATA_FRESHNESS_TTL_SECONDS=60
# Origin frontend browser yang boleh memanggil API, dipisah koma. Kosongkan
# kalau hanya dipakai Streamlit atau backend lain (panggilan server-ke-server
# tidak memerlukan CORS). Contoh: http://localhost:3000,https://ops.contoh.id
CORS_ALLOW_ORIGINS=
# Kalau diisi, semua endpoint /api/v1/* (kecuali /health) WAJIB header
# "X-API-Key" yang cocok - lihat docs/DECISIONS.md §15. Kosongkan untuk
# dev lokal/CI (endpoint tetap terbuka seperti sebelumnya). WAJIB diisi
# sebelum API terekspos di luar localhost. Dashboard membaca nilai yang
# SAMA dari variabel ini untuk mengautentikasi panggilannya sendiri.
API_KEY=
# Level log terendah yang dicetak (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=INFO
# Anggaran waktu geocoding lokasi per panggilan /api/v1/locations/map (detik).
GEOCODE_BUDGET_SECONDS_DEFAULT=60
GEOCODE_BUDGET_SECONDS_MAX=90

# Dashboard hanya bicara ke API, tidak pernah ke database.
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_PASSWORD=  
